# Optional local tool overrides used by PowerShell scripts. No secrets.
# GODOT_BIN=C:\path\to\Godot_v4.7.2-stable_win64_console.exe
# ANDROID_HOME=C:\path\to\android-sdk
# JAVA_HOME=C:\path\to\jdk-17
# Optional signed export overrides. Set the password securely in the process environment.
# GODOT_ANDROID_KEYSTORE_RELEASE_PATH=C:\private\chromatic-rush-release.jks
# GODOT_ANDROID_KEYSTORE_RELEASE_USER=chromaticrush
# GODOT_ANDROID_KEYSTORE_RELEASE_PASSWORD=<set securely; never save a real password here>
